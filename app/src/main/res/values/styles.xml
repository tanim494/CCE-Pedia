<resources>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemPaddingTop">12dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Cool Academic display type: Space Grotesk on the heading tier, Manrope stays on body/label -->
    <style name="TextAppearance.CoolAcademic.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.CoolAcademic.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.CoolAcademic.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.CoolAcademic.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.CoolAcademic.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.CoolAcademic.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="TextAppearance.CoolAcademic.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/space_grotesk_medium</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
    </style>

</resources>
