<?xml version="1.0" encoding="utf-8"?>
<!-- Backing for the "Share to Community" buttons. Theme-aware translucent scrim so the
     floating buttons stay legible over a scrolling list, framed like the app's cards
     (16dp corners + 1dp divider stroke) for a consistent surface language. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/scrim_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/dividerColor" />
</shape>
